{
  "name": "taste-of-iron",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Turn-based fighting game — browser port",
  "scripts": {
    "dev": "vite",
    "start": "concurrently -n server,spa -c blue,green \"npm run server\" \"npm run dev\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cli": "tsx ./src/cli/index.ts",
    "server": "tsx ./src/server/index.ts",
    "test": "jest",
    "coverage": "jest --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tsconfig/node20": "^20.1.2",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.11.26",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "enquirer": "^2.4.1",
    "jest": "^29.7.0",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "ws": "^8.14.2"
  }
}
